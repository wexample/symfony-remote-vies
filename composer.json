{
  "name": "wexample/symfony-remote-vies",
  "description": "EU VAT numbers checked against VIES, the European Commission's register, declared as a symfony-remote",
  "version": "2.0.4",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyRemoteVies\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyRemoteVies\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-helpers": ">=18.0.2",
    "wexample/symfony-remote": ">=2.0.10",
    "symfony/http-client": ">=7.0",
    "symfony/cache-contracts": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13",
    "symfony/cache": ">=7.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}